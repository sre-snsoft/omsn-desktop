{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMSN Desktop",
  "version": "0.1.1",
  "identifier": "my.snsoft.omsn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 440,
        "height": 660,
        "minWidth": 360,
        "minHeight": 380,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sre-snsoft/omsn-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMzhCQUUzNEU5RjgxODUKUldTRmdaOU80N280VEsyY21UZkU0VUxVNGR2OHJjTm1yOFNyUTFPTUtBNTM0YzBPellVY1YvQnQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}